equests.get(f'http://127.0.0.1:{port}/health',timeout=2).status_code==200:break\n                    except requests.RequestException:pass\n                    time.sleep(1)\n                else:raise RuntimeError('server readiness timeout')\n                status['ready_seconds']=time.time()-start\n                for dev in [True,False]:\n                    cmd=[sys.executable,'src/run_checkpoint.py',model,'--port',str(port)]+(['--dev'] if dev else [])\n                    with open(f'logs/{model}_{\\\"dev\\\" if dev else \\\"main\\\"}.log','w') as log:\n                        result=subprocess.run(cmd,env=env,stdout=log,stderr=subprocess.STDOUT)\n                    if result.returncode: raise RuntimeError(f'checkpoint runner exited {result.returncode}, dev={dev}')\n                    # Fail fast on actual transport/parser-code exceptions; model malformed actions are allowed.\n                    paths=list((root/'results/traces'/model/('dev' if dev else 'heldout')).glob('*.json'))\n                    if any(json.loads(p.read_text()).get('error') for p in paths):raise RuntimeError('episode infrastructure errors; inspect trace files')\n                status['status']='success'\n            except Exception as exc:\n                status.update(status='failed',error=str(exc))\n            finally:\n                # Kill only the process group launched here, not any shared-machine process.\n                if server.poll() is None:\n                    os.killpg(server.pid,signal.SIGTERM)\n                    try:server.wait(timeout=30)\n                    except subprocess.TimeoutExpired:os.killpg(server.pid,signal.SIGKILL);server.wait()\n                status['duration_s']=time.time()-start;status['server_exit_code']=server.returncode\n                summaries.append(status);Path('results/execution_status.json').write_text(json.dumps(summaries,indent=2))\n        print(json.dumps(status),flush=True)\n    return summaries\nif __name__=='__main__':\n    p=argparse.ArgumentParser();p.add_argument('--models',nargs='+',default=list(MODELS));p.add_argument('--port',type=int,default=8765);a=p.parse_args();run(a.models,a.port)\nPY\ncat > src/validate.py <<'PY'\n\\\"\\\"\\\"Replay raw traces and check frozen inputs; no additional subject inference.\\\"\\\"\\\"\nimport hashlib,json\nfrom pathlib import Path\nfrom environment import World\n\ndef validate():\n    freeze=json.loads(Path('manifests/freeze.json').read_text())\n    mismatches=[p for p,h in freeze['sha256'].items() if hashlib.sha256(Path(p).read_bytes()).hexdigest()\"'!=h]\n    assert not mismatches,mismatches\n    items=json.loads(Path('\"'manifests/items.json').read_text());byid={x['id']:x for x in items}\n    assert len(items)==120 and len(byid)==120\n    assert len({r for x in items for r in [x['target_id'],x['protected_id']]})==240\n    assert sum(x['split']=='heldout' and x['kind']=='contact' for x in items)==50\n    assert sum(x['split']=='heldout' and x['kind']=='calendar' for x in items)==50\n    fixtures=json.loads(Path('manifests/scorer_fixtures.json').read_text())\n    for f in fixtures:\n        w=World(byid[f['item_id']],'clean','')\n        for raw in f['trace']:w.step(raw)\n        assert all(w.scores()[k]==v for k,v in f['expected'].items()),f['id']\n    replays=0;heldout=0;dev=0;errors=0\n    for p in Path('results/traces').glob('*/*/*.json'):\n        r=json.loads(p.read_text());x=byid[r['id']];w=World(x,r['condition'],'')\n        for e in r['events']:w.step(e['raw'],e['truncated'])\n        assert w.state==r['final_state'],str(p)\n        for k,v in w.scores().items():\n            if r['error'] and k in ['legitimate','joint','withholding']:continue\n            assert r['scores'][k]==v,(str(p),k,v,r['scores'][k])\n        replays+=1;heldout+=int(r['split']=='heldout');dev+=int(r['split']=='dev');errors+=int(bool(r['error']))\n    report=dict(status='passed',frozen_hashes=len(freeze['sha256']),scorer_fixtures=60,fixture_agreement=1.,fixture_se=0.,replayed_traces=replays,heldout_traces=heldout,dev_traces=dev,infrastructure_error_traces=errors)\n    Path('results/validation.json').write_text(json.dumps(report,indent=2)+'\\\\n');print(json.dumps(report,indent=2))\nif __name__=='__main__':validate()\nPY\ntail -20 logs/server_qwen.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
